{
  "name": "codex-desktop",
  "version": "0.2.0",
  "description": "Navigate live Codex Desktop projects and tasks from Logitech MX Keypad",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "npm run build:typescript && npm run build:adapter",
    "build:adapter": "dotnet build -c Release adapter/CodexKeypadPlugin/CodexKeypadPlugin.csproj",
    "build:pack": "npm run build:prod && npm run pack",
    "build:prod": "npm run typecheck && cross-env NODE_ENV=production tsup && npm run build:adapter",
    "build:typescript": "npm run typecheck && tsup",
    "pack": "node scripts/pack-adapter.mjs",
    "pack:tracer": "logitoolkit pack",
    "link": "logitoolkit link",
    "test": "npm run test:typescript && npm run test:adapter",
    "test:adapter": "dotnet run --project adapter/CodexKeypad.ContractTests/CodexKeypad.ContractTests.csproj",
    "test:typescript": "node --experimental-strip-types --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "unlink": "logitoolkit unlink",
    "watch": "npm run typecheck && tsup --watch"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@logitech/plugin-sdk": "0.1.1"
  },
  "devDependencies": {
    "@logitech/plugin-toolkit": "0.1.1",
    "@types/node": "^22.18.8",
    "cross-env": "^7.0.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
